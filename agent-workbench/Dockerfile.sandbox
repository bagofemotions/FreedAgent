FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends git patch build-essential nodejs npm && rm -rf /var/lib/apt/lists/* && useradd --create-home --uid 10002 runner && mkdir -p /workspace /data && chown -R runner:runner /workspace
WORKDIR /app
ENV PYTHONPATH=/app
COPY requirements.txt .
RUN pip install --no-cache-dir fastapi uvicorn pydantic
COPY app ./app
WORKDIR /workspace
USER runner
EXPOSE 8090
CMD ["python","-m","app.sandbox"]
